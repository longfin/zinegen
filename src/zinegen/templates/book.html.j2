<!doctype html>
<html lang="ko">
<head>
<meta charset="utf-8">
<title>{{ book.title }}</title>
<style>
{% for ff in font_faces %}@font-face { font-family: "{{ ff.family }}"; font-weight: {{ ff.weight }}; src: url("{{ ff.file }}"); }
{% endfor %}
{% if icc %}@color-profile --press { src: url("{{ icc }}"); components: {{ icc_components }}; }{% endif %}
@page { size: {{ W }}mm {{ H }}mm; margin: 0; bleed: {{ B }}mm; }
{# No `marks:` here: WeasyPrint draws them in DeviceRGB inside a transparency group and inside the bleed.
   render.add_marks draws PDF/X-safe marks outside the bleed instead. #}
html, body { margin: 0; padding: 0; }
.page { position: relative; width: {{ W }}mm; height: {{ H }}mm; page-break-after: always; overflow: visible; }
.page:last-child { page-break-after: auto; }
.clip { position: absolute; overflow: hidden; }
{# image-orientation: none keeps WeasyPrint's JPEG passthrough. With the default (from-image) it calls
   ImageOps.exif_transpose on any image that has an EXIF block, which always returns a copy, and then
   re-encodes it at Pillow's default quality without its ICC profile. render.prepare_images applies EXIF
   orientation itself, so every file referenced here is already upright. #}
.clip img { position: absolute; display: block; image-orientation: none; }
{# Korean words are kept whole by U+2060 WORD JOINERs that the keep_all filter puts between the letters of a
   word: WeasyPrint does not support `word-break: keep-all` (it drops the declaration). `overflow-wrap`
   still breaks a word that is wider than its box. Font sizes and line heights come from layout.py, which cuts
   every text box to a whole number of lines. #}
.t { position: absolute; color: device-cmyk(0 0 0 1); white-space: pre-wrap; overflow: hidden; overflow-wrap: anywhere; }
.title { font-family: "{{ fonts.title }}", "Noto Sans CJK KR", "Noto Sans KR", "Nanum Gothic", sans-serif; font-size: {{ pt.title }}pt; line-height: {{ lh.title }}; letter-spacing: 0.02em; }
.subtitle { font-family: "{{ fonts.body }}", "Noto Sans CJK KR", "Noto Sans KR", "Nanum Gothic", sans-serif; font-size: {{ pt.subtitle }}pt; line-height: {{ lh.subtitle }}; }
.heading { font-family: "{{ fonts.title }}", "Noto Sans CJK KR", "Noto Sans KR", "Nanum Gothic", sans-serif; font-size: {{ pt.heading }}pt; line-height: {{ lh.heading }}; }
.body { font-family: "{{ fonts.body }}", "Noto Serif CJK KR", "Noto Serif KR", "Nanum Myeongjo", serif; font-size: {{ pt.body }}pt; line-height: {{ lh.body }}; text-align: justify; }
.caption { font-family: "{{ fonts.caption }}", "Noto Sans CJK KR", "Noto Sans KR", "Nanum Gothic", sans-serif; font-size: {{ pt.caption }}pt; line-height: {{ lh.caption }}; color: device-cmyk(0 0 0 0.85); }
.colophon { font-family: "{{ fonts.caption }}", "Noto Sans CJK KR", "Noto Sans KR", "Nanum Gothic", sans-serif; font-size: {{ pt.colophon }}pt; line-height: {{ lh.colophon }}; color: device-cmyk(0 0 0 0.85); }
.folio { font-family: "{{ fonts.caption }}", "Noto Sans CJK KR", "Noto Sans KR", "Nanum Gothic", sans-serif; font-size: {{ pt.folio }}pt; line-height: {{ lh.folio }}; color: device-cmyk(0 0 0 0.7); }
.center { text-align: center; } .right { text-align: right; } .left { text-align: left; }
</style>
</head>
<body>
{% for pl in pages %}
<div class="page" data-page="{{ pl.index }}" data-template="{{ pl.template }}">
{% for im in pl.images %}
  <div class="clip" style="left:{{ im.clip[0] }}mm;top:{{ im.clip[1] }}mm;width:{{ im.clip[2] }}mm;height:{{ im.clip[3] }}mm">
    <img src="{{ files[im.photo] }}" style="left:{{ '%.3f' % (im.x - im.clip[0]) }}mm;top:{{ '%.3f' % (im.y - im.clip[1]) }}mm;width:{{ '%.3f' % im.w }}mm;height:{{ '%.3f' % im.h }}mm">
  </div>
{% endfor %}
{% for t in pl.texts %}
  <div class="t {{ t.kind }} {{ t.align }}" data-page="{{ pl.index }}" data-kind="{{ t.kind }}" style="left:{{ t.x }}mm;top:{{ t.y }}mm;width:{{ t.w }}mm;height:{{ '%.3f' % t.h }}mm">{{ t.text | keep_all }}</div>
{% endfor %}
</div>
{% endfor %}
</body>
</html>
